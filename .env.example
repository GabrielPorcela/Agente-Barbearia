# ==========================================
# Configurações da aplicação Flask
# ==========================================
FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=troque-esta-chave-em-producao

# ==========================================
# Banco de dados
# ==========================================
DATABASE_URL=sqlite:///instance/barbearia.db

# ==========================================
# OpenAI API
# ==========================================
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ==========================================
# WhatsApp Cloud API (Meta)
# ==========================================
WHATSAPP_PROVIDER=meta
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Token que você escolhe e cadastra na Meta ao configurar o webhook
# (usado na verificação GET /whatsapp/webhook).
WHATSAPP_VERIFY_TOKEN=
# App Secret do App da Meta (Configurações > Básico do app no
# developers.facebook.com). Usado para validar a assinatura
# HMAC-SHA256 das requisições recebidas no webhook (X-Hub-Signature-256).
# Sem isso configurado, a validação é ignorada (apenas para uso local/dev).
WHATSAPP_APP_SECRET=

# ==========================================
# Logs
# ==========================================
# DEBUG, INFO, WARNING ou ERROR
LOG_LEVEL=INFO
