# ==========================================
# Configurações da aplicação Flask
# ==========================================
FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=troque-esta-chave-em-producao

# ==========================================
# Banco de dados
# ==========================================
# Em produção (Render), o Render injeta esta variável automaticamente com
# a URL do PostgreSQL. Deixe em branco/comentado para desenvolvimento local:
# nesse caso a aplicação usa SQLite automaticamente em instance/barbearia.db.
# DATABASE_URL=postgresql://usuario:senha@host:5432/nome_do_banco

# ==========================================
# Gemini API (Google)
# ==========================================
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# ==========================================
# WhatsApp Cloud API (Meta)
# ==========================================
WHATSAPP_PROVIDER=meta
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Token que você escolhe e cadastra na Meta ao configurar o webhook
# (usado na verificação GET /whatsapp/webhook).
WHATSAPP_VERIFY_TOKEN=
# App Secret do App da Meta (Configurações > Básico do app no
# developers.facebook.com). Usado para validar a assinatura
# HMAC-SHA256 das requisições recebidas no webhook (X-Hub-Signature-256).
# Sem isso configurado, a validação é ignorada (apenas para uso local/dev).
WHATSAPP_APP_SECRET=
# Versão da Graph API da Meta usada para enviar mensagens (opcional).
# Se não definida, o padrão atual do código é usado.
WHATSAPP_GRAPH_API_VERSION=v23.0

# ==========================================
# Logs
# ==========================================
# DEBUG, INFO, WARNING ou ERROR
LOG_LEVEL=INFO
